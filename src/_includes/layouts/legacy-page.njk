  <style>
  /*
   * Match the legacy page geometry:
   * approximately half of the browser width on desktop.
   */
  .migrated-page-content {
    width: 50%;
    margin: 0 auto;
    padding: 0;
    font-size: 18px;
    font-weight: 400;
    line-height: 1.35;
    text-align: left;
  }

  .migrated-page-content p {
    margin: 0;
  }

  /* Gap between the greeting and the application paragraph. */
  .migrated-page-content p:first-child {
    margin-bottom: 26px;
  }

  /* Preserve the visual indentation used in the original page. */
  .migrated-page-content p:nth-child(2) {
    text-indent: 1.75em;
    text-align: justify;
  }

  .migrated-page-content hr {
    margin-top: 18px;
    margin-bottom: 0;
  }

  @media (max-width: 991px) {
    .migrated-page-content {
      width: 80%;
    }
  }

  @media (max-width: 767px) {
    .migrated-page-content {
      width: 90%;
      font-size: 16px;
      line-height: 1.45;
    }

    .migrated-page-content p:nth-child(2) {
      text-indent: 0;
      text-align: left;
    }
  }
</style>
