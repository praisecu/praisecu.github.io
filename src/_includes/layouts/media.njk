<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">

  <meta
    name="viewport"
    content="width=device-width, initial-scale=1"
  >

  <title>{{ title }} | PRAISe Lab at CU Boulder</title>

  <meta
    name="description"
    content="{{ description | default('PRAISe Lab at the University of Colorado Boulder.') }}"
  >

  <meta property="og:title" content="{{ title }} | PRAISe Lab">
  <meta
    property="og:description"
    content="{{ description | default('PRAISe Lab at the University of Colorado Boulder.') }}"
  >
  <meta
    property="og:image"
    content="https://praisecu.com/img/logo/praise-logo.webp"
  >

  <link rel="icon" type="image/x-icon" href="/img/logo/praise.webp">

  <link
    rel="stylesheet"
    href="https://maxcdn.bootstrapcdn.com/bootstrap/3.3.5/css/bootstrap.min.css"
  >

  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css?family=Open+Sans:300,400,600"
  >

  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Nunito+Sans:wght@300;400;500;600;700;800;900&display=swap"
  >

  <link rel="stylesheet" href="/css/team.css">
  <link rel="stylesheet" href="/css/bootstrap.min.css">
  <link rel="stylesheet" href="/fonts/flaticon/flaticon.css">
  <link rel="stylesheet" href="/css/font-awesome.min.css">
  <link rel="stylesheet" href="/css/hippo-off-canvas.css">
  <link rel="stylesheet" href="/css/animate.css">
  <link rel="stylesheet" href="/css/language-select.css">
  <link rel="stylesheet" href="/owl.carousel/assets/owl.carousel.css">
  <link rel="stylesheet" href="/css/magnific-popup.css">
  <link rel="stylesheet" href="/css/menu.css">
  <link rel="stylesheet" href="/css/template.css">
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/responsive.css">
  <link rel="stylesheet" href="/css/research.css">
  <link rel="stylesheet" href="/css/praise-style.css">
  <link rel="stylesheet" href="/css/cards.css">

  <!-- Load last so it overrides legacy page styles. -->
  <link rel="stylesheet" href="/css/markdown-pages.css">
  <link rel="stylesheet" href="/css/modern-header.css">
  <link rel="stylesheet" href="/css/modern-footer.css">
  <link rel="stylesheet" href="/css/media-page.css">

  <script
    src="https://kit.fontawesome.com/4ad8d74216.js"
    crossorigin="anonymous"
  ></script>

  <script src="/js/vendor/modernizr-2.8.1.min.js"></script>
  {% include "components/pwa-head.njk" %}
</head>

<body>
{% include "components/modern-header.njk" %}
  <main class="modern-page media-page">
  <section class="modern-page-hero">
    <div class="modern-page-container">
      <div class="modern-page-heading">
        {% if kicker %}
          <p class="modern-page-kicker">{{ kicker }}</p>
        {% endif %}

        <h1 class="modern-page-title">{{ title }}</h1>

        {% if summary %}
          <p class="modern-page-summary">{{ summary }}</p>
        {% endif %}
      </div>
    </div>
  </section>

  <section class="media-page-section">
    <div class="media-page-container">
      <nav class="media-page-jump" aria-label="Media page sections">
        <a href="#coverage">Media Coverage</a>
        <a href="#talks">Talks and Seminars</a>
      </nav>

      <section
        id="coverage"
        class="media-group"
        aria-labelledby="coverage-title"
      >
        <header class="media-section-heading">
          <p class="media-section-heading__eyebrow">
            In the News
          </p>

          <h2
            id="coverage-title"
            class="media-section-heading__title"
          >
            Media Coverage
          </h2>
        </header>

        <div class="media-list">
          {% for item in media_coverage %}
            <article class="media-item">
              {% if item.primary_url %}
                <a
                  class="media-item__media{% if item.image_fit == 'contain' %} media-item__media--contain{% endif %}"
                  href="{{ item.primary_url }}"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Open {{ item.title }}"
                >
                  <img
                    src="{{ item.image }}"
                    alt="{{ item.title }}"
                    loading="lazy"
                  >
                </a>
              {% else %}
                <div
                  class="media-item__media{% if item.image_fit == 'contain' %} media-item__media--contain{% endif %}"
                >
                  <img
                    src="{{ item.image }}"
                    alt="{{ item.title }}"
                    loading="lazy"
                  >
                </div>
              {% endif %}

              <div class="media-item__body">
                <div class="media-item__heading">
                  <h3 class="media-item__title">
                    {{ item.title }}
                  </h3>

                  <p class="media-item__date">
                    {{ item.date }}
                  </p>
                </div>

                <p class="media-item__source">
                  {{ item.source }}
                </p>

                <p class="media-item__description">
                  {{ item.description }}
                </p>

                {% if item.links %}
                  <div
                    class="media-item__links"
                    aria-label="{{ item.title }} links"
                  >
                    {% for link in item.links %}
                      <a
                        href="{{ link.url }}"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {% if link.type == "video" %}
                          <i
                            class="fa fa-video-camera"
                            aria-hidden="true"
                          ></i>
                        {% elif link.type == "project" %}
                          <i
                            class="fa fa-paperclip"
                            aria-hidden="true"
                          ></i>
                        {% elif link.type == "award" %}
                          <i
                            class="fa fa-trophy"
                            aria-hidden="true"
                          ></i>
                        {% else %}
                          <i
                            class="fa fa-globe"
                            aria-hidden="true"
                          ></i>
                        {% endif %}

                        <span>{{ link.label }}</span>
                      </a>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        </div>
      </section>

      <section
        id="talks"
        class="media-group media-group--talks"
        aria-labelledby="talks-title"
      >
        <header class="media-section-heading">
          <p class="media-section-heading__eyebrow">
            Presentations
          </p>

          <h2
            id="talks-title"
            class="media-section-heading__title"
          >
            Talks and Seminars
          </h2>
        </header>

        <div class="media-list">
          {% for item in talks %}
            <article class="media-item media-item--talk">
              {% if item.primary_url %}
                <a
                  class="media-item__media{% if item.image_fit == 'contain' %} media-item__media--contain{% endif %}"
                  href="{{ item.primary_url }}"
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-label="Open {{ item.title }}"
                >
                  <img
                    src="{{ item.image }}"
                    alt="{{ item.title }}"
                    loading="lazy"
                  >
                </a>
              {% else %}
                <div
                  class="media-item__media{% if item.image_fit == 'contain' %} media-item__media--contain{% endif %}"
                >
                  <img
                    src="{{ item.image }}"
                    alt="{{ item.title }}"
                    loading="lazy"
                  >
                </div>
              {% endif %}

              <div class="media-item__body">
                <div class="media-item__heading">
                  <h3 class="media-item__title">
                    {{ item.title }}
                  </h3>

                  <p class="media-item__date">
                    {{ item.date }}
                  </p>
                </div>

                <p class="media-item__source">
                  {{ item.subtitle }}
                </p>

                {% if item.speaker %}
                  <p class="media-item__speaker">
                    {{ item.speaker }}
                  </p>
                {% endif %}

                {% if item.links %}
                  <div
                    class="media-item__links"
                    aria-label="{{ item.title }} links"
                  >
                    {% for link in item.links %}
                      <a
                        href="{{ link.url }}"
                        target="_blank"
                        rel="noopener noreferrer"
                      >
                        {% if link.type == "video" %}
                          <i
                            class="fa fa-video-camera"
                            aria-hidden="true"
                          ></i>
                        {% elif link.type == "pdf" %}
                          <i
                            class="fa fa-file"
                            aria-hidden="true"
                          ></i>
                        {% elif link.type == "details" %}
                          <i
                            class="fa fa-paperclip"
                            aria-hidden="true"
                          ></i>
                        {% else %}
                          <i
                            class="fa fa-globe"
                            aria-hidden="true"
                          ></i>
                        {% endif %}

                        <span>{{ link.label }}</span>
                      </a>
                    {% endfor %}
                  </div>
                {% endif %}
              </div>
            </article>
          {% endfor %}
        </div>
      </section>
    </div>
  </section>
</main>

{% include "components/modern-footer.njk" %}
  <script src="/js/jquery.js"></script>
  <script src="/js/bootstrap.min.js"></script>
  <script src="/owl.carousel/owl.carousel.min.js"></script>
  <script src="/js/jquery.magnific-popup.min.js"></script>
  <script src="/js/hippo-offcanvas.js"></script>
  <script src="/js/jquery.inview.min.js"></script>
  <script src="/js/jquery.stellar.js"></script>
  <script src="/js/jquery.countTo.js"></script>
  <script src="/js/classie.js"></script>
  <script src="/js/selectFx.js"></script>
  <script src="/js/jquery.sticky-kit.min.js"></script>
  <script src="/js/scripts.js"></script>
  <script src="/js/modern-header.js"></script>
</body>
</html>


