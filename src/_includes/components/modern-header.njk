<header class="modern-header">
  <div class="modern-header__inner">
    <a class="modern-header__brand" href="/" aria-label="PRAISe Lab home">
      <img
        class="modern-header__logo"
        src="/img/logo/boulder.webp"
        alt="University of Colorado Boulder"
      >

      <span class="modern-header__name">PRAISe Lab</span>
    </a>

    <button
      class="theme-toggle theme-toggle--mobile"
      type="button"
      data-theme-toggle
      aria-label="Switch to dark mode"
      aria-pressed="false"
      title="Switch to dark mode"
    >
      <span class="theme-toggle__track" aria-hidden="true">
        <svg
          class="theme-toggle__icon theme-toggle__icon--sun"
          viewBox="0 0 24 24"
        >
          <circle cx="12" cy="12" r="3.5"></circle>
          <path
            d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"
          ></path>
        </svg>

        <svg
          class="theme-toggle__icon theme-toggle__icon--moon"
          viewBox="0 0 24 24"
        >
          <path
            d="M20 15.2A8.5 8.5 0 0 1 8.8 4a8.5 8.5 0 1 0 11.2 11.2Z"
          ></path>
        </svg>

        <span class="theme-toggle__thumb"></span>
      </span>

      <span class="theme-toggle__label">
        Switch to dark mode
      </span>
    </button>

    <button
      class="modern-header__menu-button"
      type="button"
      aria-expanded="false"
      aria-controls="modern-header-navigation"
      aria-label="Open navigation menu"
    >
      <span class="modern-header__menu-line"></span>
      <span class="modern-header__menu-line"></span>
      <span class="modern-header__menu-line"></span>
    </button>

    <nav
  id="modern-header-navigation"
  class="modern-header__navigation"
  aria-label="Primary navigation"
>
  <button
    class="theme-toggle theme-toggle--desktop"
    type="button"
    data-theme-toggle
    aria-label="Switch to dark mode"
    aria-pressed="false"
    title="Switch to dark mode"
  >
      <span class="theme-toggle__track" aria-hidden="true">
      <svg
      class="theme-toggle__icon theme-toggle__icon--sun"
      viewBox="0 0 24 24"
      >
      <circle cx="12" cy="12" r="3.5"></circle>
      <path
        d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.65 17.65l1.42 1.42M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.65 6.35l1.42-1.42"
      ></path>
      </svg>

      <svg
      class="theme-toggle__icon theme-toggle__icon--moon"
      viewBox="0 0 24 24"
      >
      <path
        d="M20 15.2A8.5 8.5 0 0 1 8.8 4a8.5 8.5 0 1 0 11.2 11.2Z"
      ></path>
      </svg>

      <span class="theme-toggle__thumb"></span>
    </span>

    <span class="theme-toggle__label">
      Switch to dark mode
    </span>
  </button>

  <div class="modern-header__dropdown">
    <button
      class="modern-header__link modern-header__dropdown-button{% if nav == 'research' %} is-active{% endif %}"
      type="button"
      aria-expanded="false"
    >
      Research
      <i class="fa-solid fa-caret-down" aria-hidden="true"></i>
    </button>

    <div class="modern-header__dropdown-menu">
      <a href="/research-areas">Research Areas</a>
      <a href="/publications">Recent Publications</a>
    </div>
  </div>

  <a
    class="modern-header__link{% if nav == 'teaching' %} is-active{% endif %}"
    href="/teaching"
  >
    Teaching
  </a>

  <a
    class="modern-header__link{% if nav == 'team' %} is-active{% endif %}"
    href="/team"
  >
    Team
  </a>

  <a
    class="modern-header__link{% if nav == 'media' %} is-active{% endif %}"
    href="/media"
  >
    Media
  </a>

  <a
    class="modern-header__link{% if nav == 'openings' %} is-active{% endif %}"
    href="/openings"
    {% if nav == 'openings' %}aria-current="page"{% endif %}
  >
    Openings
  </a>
</nav>
  </div>
</header>

<nav
  class="mobile-bottom-nav"
  aria-label="Mobile navigation"
>
  <a
    class="mobile-bottom-nav__item{% if not nav %} is-active{% endif %}"
    href="/"
  >
    <i class="fa fa-home" aria-hidden="true"></i>
    <span>Home</span>
  </a>

  <a
    class="mobile-bottom-nav__item{% if nav == 'research' %} is-active{% endif %}"
    href="/research-areas"
  >
    <i class="fa fa-flask" aria-hidden="true"></i>
    <span>Research</span>
  </a>

  <a
    class="mobile-bottom-nav__item{% if nav == 'teaching' %} is-active{% endif %}"
    href="/teaching"
  >
    <i class="fa fa-graduation-cap" aria-hidden="true"></i>
    <span>Teaching</span>
  </a>

  <a
    class="mobile-bottom-nav__item{% if nav == 'team' %} is-active{% endif %}"
    href="/team"
  >
    <i class="fa fa-users" aria-hidden="true"></i>
    <span>Team</span>
  </a>

  <button
    class="mobile-bottom-nav__item mobile-bottom-nav__more{% if nav == 'media' or nav == 'openings' %} is-active{% endif %}"
    type="button"
    aria-expanded="false"
    aria-controls="mobile-more-menu"
  >
    <i class="fa fa-ellipsis-h" aria-hidden="true"></i>
    <span>More</span>
  </button>
</nav>

<div
  id="mobile-more-menu"
  class="mobile-more-menu"
  aria-hidden="true"
>
  <button
    class="mobile-more-menu__backdrop"
    type="button"
    aria-label="Close navigation menu"
  ></button>

  <div
    class="mobile-more-menu__panel"
    role="dialog"
    aria-modal="true"
    aria-label="More navigation links"
  >
    <div class="mobile-more-menu__handle"></div>

    <div class="mobile-more-menu__heading">
      <span>More</span>

      <button
        class="mobile-more-menu__close"
        type="button"
        aria-label="Close menu"
      >
        <i class="fa fa-times" aria-hidden="true"></i>
      </button>
    </div>

    <div class="mobile-more-menu__links">
      <a href="/publications">
        <i class="fa fa-book" aria-hidden="true"></i>
        <span>Publications</span>
      </a>

      <a href="/media">
        <i class="fa fa-camera" aria-hidden="true"></i>
        <span>Media</span>
      </a>

      <a href="/openings">
        <i class="fa fa-briefcase" aria-hidden="true"></i>
        <span>Openings</span>
      </a>
    </div>
  </div>
</div>

<aside
  id="pwa-install"
  class="pwa-install"
  aria-label="Install PRAISe Lab"
  aria-live="polite"
  hidden
>
  <img
    class="pwa-install__icon"
    src="/img/app/praise-192.png"
    alt=""
    aria-hidden="true"
  >

  <div class="pwa-install__content">
    <strong class="pwa-install__title">
      Install PRAISe Lab
    </strong>

    <span
      id="pwa-install-message"
      class="pwa-install__message"
    >
      Add PRAISe Lab to this device.
    </span>
  </div>

  <button
    id="pwa-install-button"
    class="pwa-install__button"
    type="button"
  >
    Install
  </button>

  <button
    id="pwa-install-close"
    class="pwa-install__close"
    type="button"
    aria-label="Dismiss install prompt"
  >
    <i class="fa fa-times" aria-hidden="true"></i>
  </button>
</aside>