{#
  Card media renderer.

  Cards used to embed multi-megabyte animated GIFs. Clips are now MP4 and
  behave the same way a GIF did: they autoplay, loop silently and show no
  player chrome, so the card reads as moving imagery rather than as a
  video the visitor is asked to operate. Anything that is not an MP4
  still renders as a plain image.

  Each clip is expected to sit next to a poster frame named after it,
  so /img/x/clip.mp4 pairs with /img/x/clip-poster.jpg.
#}
{% macro cardMedia(src, alt) %}
  {% if ".mp4" in src %}
    <video
      src="{{ src }}"
      poster="{{ src | replace('.mp4', '-poster.jpg') }}"
      autoplay
      loop
      muted
      playsinline
      disablepictureinpicture
      preload="metadata"
      tabindex="-1"
      aria-label="{{ alt }}"
    ></video>
  {% else %}
    <img
      src="{{ src }}"
      alt="{{ alt }}"
      loading="lazy"
    >
  {% endif %}
{% endmacro %}
