---
permalink: /spatial/index.html
eleventyExcludeFromCollections: true
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="theme-color" content="#0d0d0b">
<meta name="robots" content="noindex, nofollow">
<link rel="icon" href="/img/logo/praise.webp">
<title>PRAISe Lab</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Nunito+Sans:opsz,wght@6..12,400;6..12,600;6..12,700;6..12,800&display=swap">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">
<style>
:root {
  --gold: #CFB87C;
  --gold-soft: rgba(207, 184, 124, .18);
  --text: #ffffff;
  --text-2: rgba(255, 255, 255, .78);
  --text-3: rgba(255, 255, 255, .58);
  --glass: rgba(32, 32, 30, .52);
  --glass-2: rgba(255, 255, 255, .08);
  --glass-3: rgba(255, 255, 255, .14);
  --edge: rgba(255, 255, 255, .20);
  --radius: 2.125rem;
  --win-w: min(47.5rem, 62vw);
  --win-h: min(38.75rem, calc(100vh - 13.125rem));
}
* { box-sizing: border-box; }
html, body { margin: 0; height: 100%; }
body {
  font-family: "Nunito Sans", system-ui, sans-serif;
  color: var(--text);
  background: #0d0d0b;
  overflow: hidden;
  -webkit-font-smoothing: antialiased;
}
a { color: inherit; text-decoration: none; }

/* ---------- environment ---------- */
.env {
  position: fixed; inset: -2.5rem;
  background: url("/img/banners/boulder-campus.png") center 35% / cover no-repeat;
  filter: blur(0.1875rem) brightness(.55) saturate(1.05);
  transform: scale(1.06);
  transition: transform .9s cubic-bezier(.2, .7, .2, 1);
}
.env::after {
  content: ""; position: absolute; inset: 0;
  background:
    radial-gradient(ellipse at 50% 120%, rgba(0,0,0,.65), transparent 60%),
    radial-gradient(ellipse at 50% -20%, rgba(207,184,124,.18), transparent 55%);
}
.floor {
  position: fixed; left: 50%; bottom: 6vh; width: 70vw; height: 5.625rem;
  transform: translateX(-50%);
  background: radial-gradient(ellipse, rgba(0,0,0,.45), transparent 70%);
  filter: blur(0.75rem); pointer-events: none;
}

/* ---------- status ornament ---------- */
.status {
  position: fixed; top: 1.375rem; left: 50%; transform: translateX(-50%);
  display: flex; align-items: center; gap: 0.875rem;
  padding: 0.5625rem 1.25rem 0.5625rem 0.75rem; border-radius: 62.4375rem;
  background: var(--glass); border: 0.0625rem solid var(--edge);
  backdrop-filter: blur(1.875rem) saturate(1.6); -webkit-backdrop-filter: blur(1.875rem) saturate(1.6);
  font-size: 0.875rem; color: var(--text-2); z-index: 20;
  box-shadow: 0 0.625rem 1.875rem rgba(0,0,0,.25);
}
.status img { width: 1.75rem; height: 1.75rem; border-radius: 50%; background: #fff; padding: 0.1875rem; }
.status b { color: var(--text); font-weight: 800; letter-spacing: 0.0125rem; }
.status .classic { color: var(--text); font-weight: 700; }
.status .classic:hover { color: var(--gold); }
.status .dot { width: 0.25rem; height: 0.25rem; border-radius: 50%; background: var(--text-3); }

/* ---------- stage ---------- */
.stage {
  position: fixed; inset: 0;
  touch-action: none;
  perspective: 100rem; perspective-origin: 50% 45%;
}
.ring {
  position: absolute; left: 50%; top: calc(50% - 1.875rem);
  width: 0; height: 0; transform-style: preserve-3d;
  transition: transform .5s ease-out;
}
.win {
  position: absolute;
  width: var(--win-w); height: var(--win-h);
  left: calc(var(--win-w) / -2); top: calc(var(--win-h) / -2);
  transform-style: preserve-3d;
  transition: transform .8s cubic-bezier(.2, .75, .2, 1), opacity .6s, filter .6s;
  will-change: transform;
}
.pane {
  height: 100%; display: flex; flex-direction: column;
  border-radius: var(--radius);
  background: var(--glass);
  border: 0.0625rem solid var(--edge);
  backdrop-filter: blur(2.75rem) saturate(1.7); -webkit-backdrop-filter: blur(2.75rem) saturate(1.7);
  box-shadow: 0 2.5rem 5.625rem rgba(0,0,0,.45), inset 0 0.0625rem 0 rgba(255,255,255,.22);
  overflow: hidden;
}
.win.side { cursor: pointer; }
.ring.dragging .win { transition: none; }
.ring.dragging ~ * , .ring.dragging { user-select: none; }
.win.side .pane { pointer-events: none; }
.win.side::after {
  content: attr(data-label); position: absolute; inset: auto 0 -3.25rem 0; text-align: center;
  font-size: 0.9375rem; font-weight: 700; color: var(--text-2);
}

.head { padding: 1.625rem 2.125rem 0.875rem; display: flex; align-items: flex-end; justify-content: space-between; gap: 1rem; }
.head h2 { margin: 0; font-size: 1.875rem; font-weight: 800; letter-spacing: -0.0187rem; }
.head p { margin: 0.25rem 0 0; font-size: 0.9375rem; color: var(--text-2); }
.head .pill { flex: none; }
.body { flex: 1; overflow-y: auto; padding: 0.5rem 2.125rem 1.875rem; scrollbar-width: none; }
.body::-webkit-scrollbar { display: none; }
.body.more { -webkit-mask-image: linear-gradient(#000 calc(100% - 4.5rem), transparent); mask-image: linear-gradient(#000 calc(100% - 4.5rem), transparent); }

.pill {
  display: inline-flex; align-items: center; gap: 0.5rem;
  padding: 0.625rem 1.125rem; border-radius: 62.4375rem;
  background: var(--glass-3); color: var(--text);
  font-size: 0.9375rem; font-weight: 700; transition: background .2s;
  border: 0; font-family: inherit; cursor: pointer;
}
.pill:hover { background: rgba(255,255,255,.24); }
.pill.gold { background: var(--gold); color: #1d1e00; }
.pill.gold:hover { background: #dcc897; }
.eyebrow { font-size: 0.8125rem; font-weight: 800; letter-spacing: 0.0875rem; text-transform: uppercase; color: var(--gold); }
.tile {
  border-radius: 1.375rem; background: var(--glass-2);
  border: 0.0625rem solid rgba(255,255,255,.08);
  transition: background .2s, transform .2s;
}
a.tile:hover { background: var(--glass-3); transform: translateY(-0.125rem); }
.muted { color: var(--text-2); }
.small { font-size: 0.875rem; }

/* home */
.hero { display: flex; gap: 1.5rem; align-items: center; padding: 0.375rem 0 1.375rem; }
.hero img { width: 5.75rem; height: 5.75rem; border-radius: 1.625rem; background: #fff; padding: 0.625rem; flex: none; }
.hero h1 { margin: 0; font-size: 2.75rem; font-weight: 800; letter-spacing: -0.05rem; line-height: 1.05; }
.hero p { margin: 0.5rem 0 0; font-size: 1.125rem; color: var(--text-2); }
.mission { font-size: 1.1875rem; line-height: 1.5; margin: 0 0 1.375rem; }
.stats { display: grid; grid-template-columns: repeat(4, 1fr); gap: 0.75rem; margin-bottom: 1.5rem; }
.stat { padding: 1rem; text-align: center; }
.stat b { display: block; font-size: 2rem; font-weight: 800; color: var(--gold); line-height: 1.1; }
.stat span { font-size: 0.875rem; color: var(--text-2); }
.news { display: grid; gap: 0.5rem; }
.news a { display: flex; gap: 1rem; align-items: center; padding: 0.8125rem 1.125rem; }
.news time { flex: none; width: 5.75rem; font-size: 0.8125rem; font-weight: 700; color: var(--gold); }
.news span { font-size: 1rem; }
h3.sec { font-size: 1.125rem; margin: 0.25rem 0 0.75rem; font-weight: 800; }

/* research */
.grid2 { display: grid; grid-template-columns: 1fr 1fr; gap: 0.875rem; }
.area { overflow: hidden; display: flex; flex-direction: column; }
.area .thumb { height: 8rem; background: #222 center / cover no-repeat; }
.area div.txt { padding: 0.875rem 1rem 1rem; }
.area h4 { margin: 0 0 0.375rem; font-size: 1.0625rem; line-height: 1.3; }
.area p { margin: 0; font-size: 0.875rem; line-height: 1.45; color: var(--text-2); }

/* pubs */
.proj { display: grid; gap: 0.75rem; margin-bottom: 1.5rem; }
.proj a { display: flex; gap: 1rem; align-items: center; padding: 1rem 1.125rem; }
.proj i { flex: none; width: 2.875rem; height: 2.875rem; border-radius: 0.875rem; display: grid; place-items: center; background: var(--gold-soft); color: var(--gold); font-size: 1.1875rem; }
.proj h4 { margin: 0; font-size: 1.0625rem; line-height: 1.3; }
.proj p { margin: 0.1875rem 0 0; font-size: 0.875rem; color: var(--text-2); }
.pubs { display: grid; gap: 0.5rem; }
.pubs a { display: flex; gap: 0.875rem; align-items: baseline; padding: 0.8125rem 1.125rem; }
.pubs .yr { flex: none; font-size: 0.875rem; font-weight: 800; color: var(--gold); width: 2.5rem; }
.pubs .t { font-size: 1rem; line-height: 1.35; }
.pubs .v { display: block; font-size: 0.8125rem; color: var(--text-3); margin-top: 0.125rem; }

/* team */
.pi { display: flex; gap: 1.25rem; align-items: center; padding: 1.125rem; margin-bottom: 1.125rem; }
.pi img { width: 6.5rem; height: 6.5rem; border-radius: 50%; object-fit: cover; flex: none; border: 0.125rem solid rgba(255,255,255,.3); }
.pi h4 { margin: 0; font-size: 1.375rem; }
.pi p { margin: 0.25rem 0 0.75rem; color: var(--text-2); }
.pi .links { display: flex; gap: 0.5rem; }
.pi .links a { width: 2.375rem; height: 2.375rem; border-radius: 50%; display: grid; place-items: center; background: var(--glass-3); }
.people { display: grid; grid-template-columns: repeat(5, 1fr); gap: 0.75rem; margin-bottom: 1.375rem; }
.person { text-align: center; padding: 1rem 0.5rem 0.875rem; }
.person img { width: 4.75rem; height: 4.75rem; border-radius: 50%; object-fit: cover; display: block; margin: 0 auto 0.625rem; }
.person b { display: block; font-size: 0.9375rem; line-height: 1.25; }
.person span { font-size: 0.8125rem; color: var(--text-3); }
.alumni { display: grid; gap: 0.5rem; }
.alumni div { display: flex; justify-content: space-between; gap: 0.75rem; padding: 0.75rem 1.125rem; font-size: 0.9375rem; }
.alumni span { color: var(--text-2); text-align: right; }

/* teaching */
.course { display: flex; gap: 1.125rem; align-items: center; padding: 1rem 1.125rem; margin-bottom: 0.625rem; }
.course .code { flex: none; width: 7rem; font-size: 0.8125rem; font-weight: 800; color: var(--gold); line-height: 1.3; }
.course h4 { margin: 0; font-size: 1.0625rem; }
.course p { margin: 0.1875rem 0 0; font-size: 0.875rem; color: var(--text-2); }
.course .term { margin-left: auto; flex: none; font-size: 0.8125rem; padding: 0.375rem 0.75rem; border-radius: 62.4375rem; background: var(--glass-3); color: var(--text-2); }
.course.now .term { background: var(--gold); color: #1d1e00; font-weight: 800; }

/* openings */
.posting { padding: 1.375rem; margin-bottom: 1.125rem; }
.posting h4 { margin: 0.5rem 0 0.25rem; font-size: 1.5rem; }
.posting .sub { margin: 0 0 0.875rem; font-size: 1rem; color: var(--text-2); }
.chips { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; }
.chips span { font-size: 0.8125rem; padding: 0.375rem 0.75rem; border-radius: 62.4375rem; background: var(--glass-3); }
.note { font-size: 0.875rem; color: var(--text-2); margin: 0.75rem 0 0; }
.contact { display: grid; grid-template-columns: 1fr 1fr; gap: 0.75rem; }
.contact > * { padding: 1rem 1.125rem; display: flex; gap: 0.875rem; align-items: center; font-size: 0.9375rem; }
.contact i { color: var(--gold); width: 1.25rem; text-align: center; }


/* content shared with the regular pages */
.prose { font-size: 1.125rem; line-height: 1.55; color: var(--text); margin-bottom: 1.5rem; }
.prose p { margin: 0 0 .9rem; }
.prose a { color: var(--gold); text-decoration: underline; text-underline-offset: 3px; }
.prose strong { color: var(--text); }
.highlights { display: grid; grid-template-columns: repeat(3, 1fr); gap: .75rem; margin-bottom: 1.5rem; }
.hl { display: flex; flex-direction: column; overflow: hidden; }
.hl-img { display: block; aspect-ratio: 16 / 9; background: rgba(255,255,255,.92); }
.hl-img img, .hl-img video { width: 100%; height: 100%; object-fit: cover; display: block; }
.hl-img.contain img { object-fit: contain; }
.hl-t { padding: .7rem .85rem .85rem; font-size: .875rem; font-weight: 700; line-height: 1.35; }
.news a { padding: .6rem .9rem .6rem .6rem; }
.n-img { flex: none; width: 3.5rem; height: 3.5rem; border-radius: .75rem; overflow: hidden; background: rgba(255,255,255,.9); }
.n-img img, .n-img video { width: 100%; height: 100%; object-fit: cover; display: block; }
.n-txt { display: flex; flex-direction: column; gap: .15rem; }
.n-txt time { width: auto; }
.n-txt b { font-size: 1rem; font-weight: 700; line-height: 1.3; }
.areas { display: grid; gap: .9rem; }
.areas .area { flex-direction: row; }
.areas .thumb { flex: none; width: 38%; height: auto; min-height: 10rem; background: #111; }
.areas .thumb img, .areas .thumb video { width: 100%; height: 100%; object-fit: cover; display: block; }
.areas .txt { padding: 1rem 1.1rem 1.1rem; }
.chips a { font-size: .8125rem; padding: .35rem .75rem; border-radius: 999px; background: var(--glass-3); color: var(--text); font-weight: 600; transition: background .2s; }
.chips a:hover { background: rgba(255,255,255,.26); }
.chips { margin: .75rem 0 0; }
.chips.plain { margin: 0 0 1rem; }
.pubs { gap: .75rem; margin-bottom: 1.5rem; }
.pub { display: flex; gap: 1rem; padding: .85rem; align-items: flex-start; }
.p-img { flex: none; width: 10.5rem; aspect-ratio: 16 / 10; border-radius: .9rem; overflow: hidden; background: rgba(255,255,255,.92); display: block; }
.p-img img, .p-img video { width: 100%; height: 100%; object-fit: contain; display: block; }
.pub .date { font-size: .8125rem; font-weight: 800; color: var(--gold); }
.pub h4 { margin: .2rem 0 .25rem; font-size: 1.0625rem; line-height: 1.3; }
.pub .venue { margin: 0 0 .2rem; font-size: .875rem; color: var(--text-2); font-weight: 600; }
.pub .authors { margin: 0; font-size: .8125rem; color: var(--text-3); line-height: 1.45; }
.course { padding: .75rem; }
.c-img { flex: none; width: 8.5rem; aspect-ratio: 16 / 9; border-radius: .75rem; overflow: hidden; background: rgba(255,255,255,.92); }
.c-img img, .c-img video { width: 100%; height: 100%; object-fit: cover; display: block; }
.c-txt { display: flex; flex-direction: column; gap: .15rem; }
.c-txt .code { width: auto; }
.c-txt b { font-size: 1.0625rem; }
.c-txt .sub { font-size: .875rem; color: var(--text-2); }
.course.now { outline: 2px solid var(--gold); outline-offset: -2px; }
.person .links, .pi .links { display: flex; gap: .4rem; justify-content: center; margin-top: .6rem; }
.person .links a { width: 2rem; height: 2rem; border-radius: 50%; display: grid; place-items: center; background: var(--glass-3); font-size: .8125rem; }
.pi .links { justify-content: flex-start; }
.people { grid-template-columns: repeat(auto-fill, minmax(8.5rem, 1fr)); }
.post-img { width: 100%; aspect-ratio: 21 / 9; object-fit: cover; border-radius: 1rem; margin-bottom: 1rem; display: block; }
.posting .actions { display: flex; gap: .6rem; flex-wrap: wrap; }


/* previous / next ornaments beside the front window */
.flip {
  position: fixed; top: calc(50% - 1.875rem); z-index: 15;
  width: 4rem; height: 4rem; border-radius: 50%; display: grid; place-items: center;
  border: 1px solid var(--edge); color: var(--text); font-size: 1.375rem; cursor: pointer;
  background: var(--glass);
  backdrop-filter: blur(1.875rem) saturate(1.6); -webkit-backdrop-filter: blur(1.875rem) saturate(1.6);
  box-shadow: 0 .625rem 1.875rem rgba(0,0,0,.3);
  transition: background .2s, opacity .3s, transform .2s;
}
.flip:hover { background: rgba(255,255,255,.28); transform: scale(1.06); }
.flip:disabled { opacity: 0; pointer-events: none; }
.flip.prev { left: calc(50% - var(--win-w) / 2 - 5.5rem); }
.flip.next { right: calc(50% - var(--win-w) / 2 - 5.5rem); }

/* ---------- tab bar ornament ---------- */
.tabbar {
  position: fixed; left: 50%; bottom: 1.625rem; transform: translateX(-50%);
  display: flex; gap: 0.25rem; padding: 0.4375rem; border-radius: 62.4375rem; z-index: 20;
  background: var(--glass); border: 0.0625rem solid var(--edge);
  backdrop-filter: blur(1.875rem) saturate(1.6); -webkit-backdrop-filter: blur(1.875rem) saturate(1.6);
  box-shadow: 0 0.875rem 2.5rem rgba(0,0,0,.35);
}
.tabbar button {
  border: 0; background: transparent; color: var(--text-2); font-family: inherit;
  display: flex; align-items: center; gap: 0.5625rem; padding: 0.6875rem 1.125rem; border-radius: 62.4375rem;
  font-size: 0.9375rem; font-weight: 700; cursor: pointer; transition: background .2s, color .2s;
}
.tabbar button:hover { background: var(--glass-2); color: var(--text); }
.tabbar button[aria-selected="true"] { background: rgba(255,255,255,.9); color: #1d1e00; }
.tabbar .short { display: none; }
.tabbar .badge { font-size: 0.625rem; font-weight: 800; background: var(--gold); color: #1d1e00; padding: 0.125rem 0.375rem; border-radius: 6.1875rem; }
.hint { position: fixed; right: 1.625rem; bottom: 2.125rem; font-size: 0.8125rem; color: var(--text-3); z-index: 20; }

/* ---------- narrower screens: flat, one window ---------- */
@media (max-width: 900px) {
  body { overflow: auto; }
  :root { --win-w: calc(100vw - 2rem); --win-h: calc(100vh - 11.875rem); --radius: 1.625rem; }
  .stage { perspective: none; }
  .ring { transform: none !important; }
  .win { transform: none !important; opacity: 0; pointer-events: none; }
  .win.active { opacity: 1; pointer-events: auto; }
  .win.side::after { display: none; }
  .head { padding: 1.25rem 1.25rem 0.625rem; }
  .head h2 { font-size: 1.5rem; }
  .body { padding: 0.375rem 1.25rem 1.5rem; }
  .hero h1 { font-size: 1.875rem; }
  .hero img { width: 4rem; height: 4rem; border-radius: 1.125rem; }
  .stats { grid-template-columns: repeat(2, 1fr); }
  .grid2, .contact, .highlights { grid-template-columns: 1fr; }
  .areas .area, .pub { flex-direction: column; }
  .areas .thumb, .p-img { width: 100%; }
  .people { grid-template-columns: repeat(2, 1fr); }
  .course { flex-wrap: wrap; }
  .course .term { margin-left: 0; }
  .tabbar { left: 1rem; right: 1rem; transform: none; overflow-x: auto; justify-content: space-between; }
  .tabbar { overflow: hidden; gap: 0; padding: 0.3125rem; }
  .tabbar button { flex: 1 1 0; min-width: 0; flex-direction: column; gap: 0.25rem; padding: 0.5625rem 0.125rem; font-size: 0.6875rem; }
  .tabbar .full { display: none; }
  .tabbar .short { display: inline; }
  .pi { flex-direction: column; text-align: center; }
  .pi .links { justify-content: center; }
  .tabbar button .lbl-badge { display: none; }
  .hint, .status .extra { display: none; }
  .flip { display: none; }
}
@media (prefers-reduced-motion: reduce) {
  .win, .ring, .env { transition: none; }
}
</style>
</head>
<body>
<div class="env" id="env"></div>
<div class="floor"></div>

<div class="status">
  <img src="/img/logo/praise.webp" alt="">
  <b>PRAISe Lab</b>
  <span class="dot extra"></span>
  <span class="extra">University of Colorado Boulder</span>
  <span class="dot"></span>
  <span id="clock"></span>
  <span class="dot"></span>
  <a class="classic" href="/?classic">Classic site</a>
</div>

{%- set home = collections.all | pageData("/") -%}
{%- set research = collections.all | pageData("/research-areas.html") -%}
{%- set pubs = collections.all | pageData("/publications.html") -%}
{%- set teach = collections.all | pageData("/teaching.html") -%}
{%- set team = collections.all | pageData("/team.html") -%}
{%- set media = collections.all | pageData("/media.html") -%}
{%- set openings = collections.all | pageData("/openings.html") -%}
{%- set newsPage = collections.all | pageData("/news.html") -%}
{%- macro src(u) -%}{% if u and not ("://" in u) and u[0] != "/" %}/{{ u }}{% else %}{{ u }}{% endif %}{%- endmacro -%}
{%- macro thumb(u, alt="", cls="") -%}
  {%- if u and (u | lower).endsWith(".mp4") -%}
  <video class="{{ cls }}" src="{{ src(u) }}" autoplay muted loop playsinline aria-label="{{ alt }}"></video>
  {%- elif u -%}
  <img class="{{ cls }}" src="{{ src(u) }}" alt="{{ alt }}" loading="lazy">
  {%- endif -%}
{%- endmacro -%}
{%- macro ext(u) -%}{% if u and "://" in u %} target="_blank" rel="noopener"{% endif %}{%- endmacro -%}
<main class="stage">
  <div class="ring" id="ring">

    <!-- Home: index.md and the latest news -->
    <section class="win" data-label="Home" data-icon="fa-house" aria-label="Home">
      <div class="pane">
        <div class="body" style="padding-top:1.875rem">
          <div class="hero">
            <img src="/img/logo/praise.webp" alt="">
            <div>
              <div class="eyebrow">University of Colorado Boulder</div>
              <h1>PRAISe Lab</h1>
              <p>Perception, Robotics, AI and Sensing</p>
            </div>
          </div>
          <div class="prose">{{ collections.all | pageBody("/") | markdown | safe }}</div>
          <h3 class="sec">Highlights</h3>
          <div class="highlights">
            {%- for slide in home.hero_slides %}
            <a class="tile hl" href="{{ slide.text_url or slide.image_url }}"{{ ext(slide.text_url or slide.image_url) }}>
              <span class="hl-img {{ 'contain' if slide.fit == 'contain' }}">{{ thumb(slide.image, slide.alt) }}</span>
              <span class="hl-t">{{ slide.title }}</span>
            </a>
            {%- endfor %}
          </div>
          <h3 class="sec">Latest news</h3>
          <div class="news">
            {%- for item in newsPage.news | sortNewsNewest | take(6) %}
            <a class="tile" href="{{ src(item.url) if item.url else '/news.html' }}"{{ ext(item.url) }}>
              <span class="n-img">{{ thumb(item.image, item.image_alt) }}</span>
              <span class="n-txt"><time>{{ item.date }}</time><b>{{ item.title }}</b></span>
            </a>
            {%- endfor %}
          </div>
        </div>
      </div>
    </section>

    <!-- Research: research-areas.md -->
    <section class="win" data-label="Research" data-icon="fa-flask" aria-label="Research areas">
      <div class="pane">
        <div class="head">
          <div><h2>{{ research.title }}</h2><p>{{ research.summary }}</p></div>
          <a class="pill" href="/research-areas.html">Open <i class="fa-solid fa-arrow-up-right-from-square"></i></a>
        </div>
        <div class="body">
          <div class="areas">
            {%- for area in research.research_areas %}
            <article class="tile area">
              <div class="thumb">{{ thumb(area.image, area.title) }}</div>
              <div class="txt">
                <h4>{{ area.title }}</h4>
                <p>{{ area.description }}</p>
                {%- if area.links %}
                <div class="chips">
                  {%- for link in area.links %}<a href="{{ link.url }}"{{ ext(link.url) }}>{{ link.label }}</a>{% endfor %}
                </div>
                {%- endif %}
              </div>
            </article>
            {%- endfor %}
          </div>
        </div>
      </div>
    </section>

    <!-- Publications: publications.md -->
    <section class="win" data-label="Publications" data-short="Papers" data-icon="fa-book-open" aria-label="Publications">
      <div class="pane">
        <div class="head">
          <div><h2>{{ pubs.title }}</h2><p>{{ pubs.summary }}</p></div>
          <a class="pill" href="/publications.html">Open <i class="fa-solid fa-arrow-up-right-from-square"></i></a>
        </div>
        <div class="body">
          <div class="pubs">
            {%- for p in pubs.publications %}
            <article class="tile pub">
              <a class="p-img" href="{{ p.primary_url }}"{{ ext(p.primary_url) }}>{{ thumb(p.image, p.title) }}</a>
              <div>
                <span class="date">{{ p.date }}</span>
                <h4><a href="{{ p.primary_url }}"{{ ext(p.primary_url) }}>{{ p.title }}</a></h4>
                <p class="venue">{{ p.venue }}</p>
                <p class="authors">{{ p.authors }}</p>
                {%- if p.links %}
                <div class="chips">
                  {%- for link in p.links %}<a href="{{ link.url }}"{{ ext(link.url) }}>{{ link.label }}</a>{% endfor %}
                </div>
                {%- endif %}
              </div>
            </article>
            {%- endfor %}
          </div>
        </div>
      </div>
    </section>

    <!-- Teaching: teaching.md -->
    <section class="win" data-label="Teaching" data-icon="fa-chalkboard-user" aria-label="Teaching">
      <div class="pane">
        <div class="head">
          <div><h2>{{ teach.title }}</h2><p>{{ teach.kicker }}</p></div>
          <a class="pill" href="/teaching.html">Open <i class="fa-solid fa-arrow-up-right-from-square"></i></a>
        </div>
        <div class="body">
          {%- for term in teach.teaching_terms %}
          {%- set firstTerm = loop.first %}
          <h3 class="sec">{{ term.name }}</h3>
          {%- for course in term.courses %}
          <a class="tile course{{ ' now' if loop.first and firstTerm }}" href="{{ course.url }}"{{ ext(course.url) }}>
            <span class="c-img">{{ thumb(course.media, course.media_alt) }}</span>
            <span class="c-txt">
              <span class="code">{{ course.code }}</span>
              <b>{{ course.title }}</b>
              {%- if course.subtitle %}<span class="sub">{{ course.subtitle }}</span>{% endif %}
            </span>
          </a>
          {%- endfor %}
          {%- endfor %}
        </div>
      </div>
    </section>

    <!-- Team: team.md -->
    <section class="win" data-label="Team" data-icon="fa-user-group" aria-label="Team">
      <div class="pane">
        <div class="head">
          <div><h2>{{ team.title }}</h2><p>{{ team.kicker }}</p></div>
          <a class="pill" href="/team.html">Open <i class="fa-solid fa-arrow-up-right-from-square"></i></a>
        </div>
        <div class="body">
          {%- set pi = team.principal_investigator %}
          <div class="tile pi">
            <img src="{{ pi.image }}" alt="{{ pi.name }}">
            <div>
              <div class="eyebrow">{{ pi.role }}</div>
              <h4>{{ pi.name }}</h4>
              <div class="links">
                {%- for link in pi.links %}
                <a href="{{ link.url }}"{{ ext(link.url) }} aria-label="{{ link.label }}" title="{{ link.label }}"><i class="{{ 'fa-brands fa-x-twitter' if link.type == 'x' else ('fa-brands fa-linkedin-in' if link.type == 'linkedin' else ('fa-brands fa-github' if link.type == 'github' else 'fa-solid fa-graduation-cap')) }}"></i></a>
                {%- endfor %}
              </div>
            </div>
          </div>
          <h3 class="sec">Current students</h3>
          <div class="people">
            {%- for person in team.current_students %}
            <div class="tile person">
              <img src="{{ person.image }}" alt="">
              <b>{{ person.name }}</b>
              <span>{{ person.role }}</span>
              {%- if person.links %}
              <div class="links">
                {%- for link in person.links %}
                <a href="{{ link.url }}"{{ ext(link.url) }} aria-label="{{ link.label }}" title="{{ link.label }}"><i class="{{ 'fa-brands fa-x-twitter' if link.type == 'x' else ('fa-brands fa-linkedin-in' if link.type == 'linkedin' else ('fa-brands fa-github' if link.type == 'github' else 'fa-solid fa-graduation-cap')) }}"></i></a>
                {%- endfor %}
              </div>
              {%- endif %}
            </div>
            {%- endfor %}
          </div>
          {%- if team.alumni %}
          <h3 class="sec">Alumni</h3>
          <div class="alumni">
            {%- for person in team.alumni %}
            <div class="tile"><b>{{ person.name }}</b><span>{{ person.destination }}</span></div>
            {%- endfor %}
          </div>
          {%- endif %}
        </div>
      </div>
    </section>

    <!-- Media: media.md -->
    <section class="win" data-label="Media" data-icon="fa-newspaper" aria-label="Media">
      <div class="pane">
        <div class="head">
          <div><h2>{{ media.title }}</h2><p>{{ media.summary }}</p></div>
          <a class="pill" href="/media.html">Open <i class="fa-solid fa-arrow-up-right-from-square"></i></a>
        </div>
        <div class="body">
          <h3 class="sec">In the news</h3>
          <div class="pubs">
            {%- for m in media.media_coverage %}
            <article class="tile pub">
              <a class="p-img" href="{{ m.primary_url }}"{{ ext(m.primary_url) }}>{{ thumb(m.image, m.title) }}</a>
              <div>
                <span class="date">{{ m.source }} · {{ m.date }}</span>
                <h4><a href="{{ m.primary_url }}"{{ ext(m.primary_url) }}>{{ m.title }}</a></h4>
                <p class="authors">{{ m.description }}</p>
                {%- if m.links %}
                <div class="chips">
                  {%- for link in m.links %}<a href="{{ link.url }}"{{ ext(link.url) }}>{{ link.label }}</a>{% endfor %}
                </div>
                {%- endif %}
              </div>
            </article>
            {%- endfor %}
          </div>
          {%- if media.talks %}
          <h3 class="sec">Talks</h3>
          <div class="pubs">
            {%- for t in media.talks %}
            <article class="tile pub">
              <a class="p-img" href="{{ t.primary_url }}"{{ ext(t.primary_url) }}>{{ thumb(t.image, t.title) }}</a>
              <div>
                <span class="date">{{ t.date }}</span>
                <h4><a href="{{ t.primary_url }}"{{ ext(t.primary_url) }}>{{ t.title }}</a></h4>
                {%- if t.subtitle %}<p class="venue">{{ t.subtitle }}</p>{% endif %}
                {%- if t.speaker %}<p class="authors">{{ t.speaker }}</p>{% endif %}
                {%- if t.links %}
                <div class="chips">
                  {%- for link in t.links %}<a href="{{ link.url }}"{{ ext(link.url) }}>{{ link.label }}</a>{% endfor %}
                </div>
                {%- endif %}
              </div>
            </article>
            {%- endfor %}
          </div>
          {%- endif %}
        </div>
      </div>
    </section>

    <!-- Openings: openings.md -->
    <section class="win" data-label="Openings" data-icon="fa-briefcase" data-badge="{{ navBadges.openings }}" aria-label="Openings">
      <div class="pane">
        <div class="head">
          <div><h2>{{ openings.title }}</h2><p>{{ openings.kicker }}</p></div>
          <a class="pill" href="/openings.html">Open <i class="fa-solid fa-arrow-up-right-from-square"></i></a>
        </div>
        <div class="body">
          {%- for post in openings.postings %}
          <div class="tile posting">
            {%- if post.image %}<img class="post-img" src="{{ post.image }}" alt="{{ post.image_alt }}">{% endif %}
            {%- if post.status %}<span class="eyebrow">{{ post.status }}</span>{% endif %}
            <h4>{{ post.title }}</h4>
            {%- if post.subtitle %}<p class="sub">{{ post.subtitle }}</p>{% endif %}
            {%- if post.meta %}
            <div class="chips plain">{% for m in post.meta %}<span>{{ m }}</span>{% endfor %}</div>
            {%- endif %}
            <div class="actions">
              {%- if post.apply_url %}<a class="pill gold" href="{{ post.apply_url }}"{{ ext(post.apply_url) }}>{{ post.apply_label or "Apply" }} <i class="fa-solid fa-arrow-right"></i></a>{% endif %}
              <a class="pill" href="/openings.html">Details</a>
            </div>
            {%- if post.apply_note %}<p class="note">{{ post.apply_note }}</p>{% endif %}
          </div>
          {%- endfor %}
          <div class="tile posting">
            <span class="eyebrow">Prospective students</span>
            <p class="sub">{{ openings.summary }}</p>
            <div class="actions">
              {%- if openings.application_url %}<a class="pill gold" href="{{ openings.application_url }}"{{ ext(openings.application_url) }}>{{ openings.application_label }} <i class="fa-solid fa-arrow-right"></i></a>{% endif %}
              {%- if openings.secondary_url %}<a class="pill" href="{{ openings.secondary_url }}">{{ openings.secondary_label }}</a>{% endif %}
            </div>
          </div>
          <h3 class="sec">Find us</h3>
          <div class="contact">
            <div class="tile"><i class="fa-solid fa-building"></i>Labs: ECES 1B14 and DLC 2B40</div>
            <div class="tile"><i class="fa-solid fa-door-open"></i>Office: ECES 152</div>
            <a class="tile" href="https://mailhide.io/e/c7L2GJRn" target="_blank" rel="noopener"><i class="fa-solid fa-envelope"></i>Email the lab</a>
            <a class="tile" href="https://github.com/praisecu" target="_blank" rel="noopener"><i class="fa-brands fa-github"></i>github.com/praisecu</a>
          </div>
        </div>
      </div>
    </section>

  </div>
</main>

<button class="flip prev" id="prev" type="button" aria-label="Previous window"><i class="fa-solid fa-chevron-left"></i></button>
<button class="flip next" id="next" type="button" aria-label="Next window"><i class="fa-solid fa-chevron-right"></i></button>
<nav class="tabbar" id="tabbar" role="tablist" aria-label="Windows"></nav>
<div class="hint">Swipe sideways or use ‹ › to move between windows</div>

<script>
(() => {
  const wins = [...document.querySelectorAll(".win")];
  const tabbar = document.getElementById("tabbar");
  const ring = document.getElementById("ring");
  const env = document.getElementById("env");
  const STEP = 42;
  let R = 1350, U = 1;
  function fit() {
    const wide = innerWidth > 900;
    U = wide ? Math.max(.85, Math.min(2.1, .8 * Math.min(innerWidth * .62 / 760, innerHeight / 740))) : 1;
    document.documentElement.style.fontSize = (16 * U) + "px";
    R = 1350 * U;
  }
  fit();
  let active = 0;

  wins.forEach((w, i) => {
    const b = document.createElement("button");
    b.setAttribute("role", "tab");
    b.innerHTML = `<i class="fa-solid ${w.dataset.icon}"></i><span class="full">${w.dataset.label}</span><span class="short">${w.dataset.short || w.dataset.label}</span>` +
      (w.dataset.badge ? ` <span class="badge lbl-badge">${w.dataset.badge}</span>` : "");
    b.addEventListener("click", () => go(i));
    tabbar.appendChild(b);
    w.addEventListener("click", () => { if (i !== active) go(i); });
  });

  // pos is the window position on the arc; fractional while dragging.
  function layout(pos = active) {
    wins.forEach((w, i) => {
      const d = i - pos, ad = Math.abs(d);
      const a = d * STEP * Math.PI / 180;
      const x = R * Math.sin(a), z = -R * (1 - Math.cos(a));
      const far = ad >= 1.5;
      w.style.transform = `translate3d(${x}px, 0, ${z - Math.min(ad, 1) * 260 * U}px) rotateY(${-d * STEP}deg)`;
      w.style.opacity = ad <= 1 ? 1 - .38 * ad : Math.max(0, .62 * (2 - ad) * 2 - .62);
      w.style.filter = ad > .05 ? "saturate(.8)" : "none";
      w.style.pointerEvents = far ? "none" : "auto";
      w.style.zIndex = 10 - Math.round(ad);
      const on = i === Math.round(pos);
      w.classList.toggle("side", !on);
      w.classList.toggle("active", on);
      tabbar.children[i].setAttribute("aria-selected", on);
    });
    env.style.transform = `scale(1.06) translateX(${-pos * 14}px)`;
    const p = document.getElementById("prev"), n = document.getElementById("next");
    if (p) { p.disabled = Math.round(pos) <= 0; n.disabled = Math.round(pos) >= wins.length - 1; }
  }
  function go(i) { active = Math.max(0, Math.min(wins.length - 1, i)); layout(); }

  const bodies = [...document.querySelectorAll(".body")];
  const fade = () => bodies.forEach(b => b.classList.toggle("more", b.scrollTop + b.clientHeight < b.scrollHeight - 4));
  bodies.forEach(b => b.addEventListener("scroll", fade, { passive: true }));
  fade();
  addEventListener("resize", () => { fit(); layout(); fade(); });
  // Horizontal swipes and scrolls move between windows: trackpad and
  // mouse horizontal scrolling, touch swipes, and pinch-and-drag on Vision Pro.
  let wheelX = 0, wheelLock = 0, wheelReset;
  addEventListener("wheel", e => {
    if (Math.abs(e.deltaX) <= Math.abs(e.deltaY)) return;
    e.preventDefault();
    if (Date.now() < wheelLock) return;
    wheelX += e.deltaX;
    clearTimeout(wheelReset);
    wheelReset = setTimeout(() => wheelX = 0, 180);
    if (Math.abs(wheelX) > 70) {
      go(active + Math.sign(wheelX));
      wheelX = 0;
      wheelLock = Date.now() + 550;
    }
  }, { passive: false });

  // Drags are locked to one axis after the first few pixels. Sideways
  // drags move between windows; for touch (including pinch-and-drag on
  // Vision Pro) vertical drags scroll the window under the finger here,
  // with momentum, instead of letting the browser guess the direction.
  const stage = document.querySelector(".stage");
  const LOCK = 10;
  let drag = null, swallowClick = false, glide = 0;
  const span = () => Math.min(innerWidth * .6, 900);

  stage.addEventListener("pointerdown", e => {
    if (e.pointerType === "mouse" && e.button !== 0) return;
    cancelAnimationFrame(glide);
    const body = e.target.closest(".win.active .body");
    drag = { x: e.clientX, y: e.clientY, id: e.pointerId, axis: null, touch: e.pointerType !== "mouse",
             body, top: body ? body.scrollTop : 0, lastY: e.clientY, lastT: performance.now(), v: 0 };
  });
  addEventListener("pointermove", e => {
    if (!drag || e.pointerId !== drag.id) return;
    const dx = e.clientX - drag.x, dy = e.clientY - drag.y;
    if (!drag.axis) {
      if (Math.hypot(dx, dy) < LOCK) return;
      drag.axis = Math.abs(dx) > Math.abs(dy) * .9 ? "x" : "y";
      if (drag.axis === "x") ring.classList.add("dragging");
      if (drag.axis === "y" && !drag.touch) { drag = null; return; }
      try { stage.setPointerCapture(drag.id); } catch (error) {}
    }
    if (drag.axis === "x") {
      layout(Math.max(-.35, Math.min(wins.length - .65, active - dx / span())));
    } else if (drag.body) {
      const now = performance.now(), dt = Math.max(1, now - drag.lastT);
      drag.v = .8 * drag.v + .2 * ((e.clientY - drag.lastY) / dt);
      drag.lastY = e.clientY; drag.lastT = now;
      drag.body.scrollTop = drag.top - dy;
    }
  });
  const endDrag = e => {
    if (!drag || e.pointerId !== drag.id) return;
    const d = drag; drag = null;
    if (!d.axis) return;
    swallowClick = true;
    setTimeout(() => swallowClick = false, 0);
    if (d.axis === "x") {
      ring.classList.remove("dragging");
      const dx = e.clientX - d.x, sp = span();
      const step = Math.abs(dx) > sp * .15 ? -Math.sign(dx) * Math.max(1, Math.round(Math.abs(dx) / sp)) : 0;
      go(active + step);
    } else if (d.body) {
      let v = d.v * 16;
      const run = () => {
        if (Math.abs(v) < .3) return;
        d.body.scrollTop -= v; v *= .94;
        glide = requestAnimationFrame(run);
      };
      run();
    }
  };
  addEventListener("pointerup", endDrag);
  addEventListener("pointercancel", e => { if (drag && drag.axis === "x") { ring.classList.remove("dragging"); layout(); } drag = null; });
  addEventListener("click", e => { if (swallowClick) { e.preventDefault(); e.stopPropagation(); } }, true);

  document.getElementById("prev").addEventListener("click", () => go(active - 1));
  document.getElementById("next").addEventListener("click", () => go(active + 1));

  addEventListener("keydown", e => {
    if (e.key === "ArrowRight") go(active + 1);
    if (e.key === "ArrowLeft") go(active - 1);
  });
  addEventListener("pointermove", e => {
    if (innerWidth <= 900) return;
    const rx = (e.clientY / innerHeight - .5) * -3, ry = (e.clientX / innerWidth - .5) * 4;
    ring.style.transform = `rotateX(${rx}deg) rotateY(${ry}deg)`;
  });

  const clock = document.getElementById("clock");
  const tick = () => clock.textContent = new Date().toLocaleTimeString([], { hour: "numeric", minute: "2-digit" });
  tick(); setInterval(tick, 30000);
  layout();
})();
</script>
</body>
</html>
